# --- Smartsheet ---
SMARTSHEET_ACCESS_TOKEN=your_smartsheet_api_token
SMARTSHEET_SHEET_ID=1234567890123456

# --- Sentry ---
# Create an auth token at https://sentry.io/settings/account/api/auth-tokens/ with `event:read` and `project:read`
SENTRY_AUTH_TOKEN=your_sentry_token
SENTRY_ORG_SLUG=your-org-slug
# Comma-separated list of project slugs. Leave blank to scan all projects in the org.
SENTRY_PROJECT_SLUGS=project-one,project-two
# Optional: API host (defaults to https://sentry.io)
SENTRY_HOST=https://sentry.io
# Sentry query (defaults to is:unresolved)
SENTRY_QUERY=is:unresolved

# --- GitHub ---
# Personal access token with `repo` scope (or fine-grained token with Issues: read)
GITHUB_TOKEN=ghp_xxx
# Comma-separated list of "owner/repo" entries to scan
GITHUB_REPOS=owner/repo-one,owner/repo-two
# Issue label to filter by (defaults to "bug")
GITHUB_BUG_LABEL=bug

# --- Linear ---
# Create at https://linear.app/settings/api
LINEAR_API_KEY=lin_api_xxx
# Optional: only pull issues with this label (defaults to "Bug"); set to empty to pull all issues
LINEAR_BUG_LABEL=Bug
# Optional: filter to specific team keys, comma separated (e.g. ENG,WEB). Blank = all teams.
LINEAR_TEAM_KEYS=

# --- Context generation (optional) ---
# If set, OpenAI is used to generate a fix-suggestion for each bug's "Context" column.
# If unset, a deterministic rule-based summary is used instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
